NODE_ENV=development
PORT=5000
DATA_STORE=file
# V2_DATA_STORE=local maps data/archive.json into the /api/v2 read-only API
# for local development only. Defaults to 'empty' (no data) when unset —
# never set to 'local' in production. See V2-ARCHITECTURE.md.
# V2_DATA_STORE=local
GOOGLE_CLOUD_PROJECT=antiochia-archive
ADMIN_TOKEN=
ARCHIVE_JSON_PATH=../data/archive.json
SUBMISSIONS_JSON_PATH=../data/submissions.json
# Optional overrides for the local v2 editorial data files (used only when
# V2_DATA_STORE=local). Default to ../data/v2/entities.json and
# ../data/v2/relationships.json. See V2-ARCHITECTURE.md "Config paths".
# V2_ENTITIES_JSON_PATH=../data/v2/entities.json
# V2_RELATIONSHIPS_JSON_PATH=../data/v2/relationships.json
#
# V2_DATA_STORE=sqlite is the local-first, no-code CMS runtime (Section 5 of
# the "no-code CMS" round): admin Publish/Edit/Archive/Restore write
# directly to this database and the public API sees the change immediately
# — no editorial draft, no apply script, no rebuild. See
# backend/PERSISTENCE.md "Runtime content database (SQLite)". Seed it once
# from the canonical JSON with: cd backend && npm run migrate:sqlite -- --apply
#
# *** DO NOT set V2_DATA_STORE=sqlite on Cloud Run. ***
# Cloud Run's container filesystem is EPHEMERAL — a SQLite file written
# there is silently lost on every restart/scale-to-zero/redeploy. The
# backend refuses to start in this mode with V2_DATA_STORE=sqlite unless
# SQLITE_ON_CLOUD_RUN_ACK=true is ALSO explicitly set (see
# db/sqliteConnection.js's assertSafeToActivateSqlite()). SQLite here is
# for a single, persistent, local/on-prem machine only.
# V2_DATA_STORE=sqlite
# SQLITE_DB_PATH=./var/database/antiochia.db
# MEDIA_STORAGE_DRIVER=local
# LOCAL_STORAGE_ROOT=./var/storage
# BACKUP_ROOT=./var/backups
MAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_USER=example@gmail.com
MAIL_PASS=your_app_password
MAIL_TO=archive-admin@example.com
CLIENT_URL=http://localhost:5173
