# ── Build artifacts ────────────────────────────────────────────────────────
node_modules
# Note: dist/ is NOT excluded — multi-stage Dockerfile builds inside container
# and does not rely on a pre-built dist/ from the host.
.vite

# ── Backend source (served separately) ─────────────────────────────────────
# backend/v2 and backend/dataModel.js are the exception: they are pure,
# no-secrets mapping/schema/serializer logic (no node_modules, no .env, no
# server/auth code) that scripts/v2-archive-release.js imports at frontend
# build time to compute the static v2 detail pages. See Dockerfile.
backend
!backend/dataModel.js
!backend/v2
!backend/v2/**
data/*
!data/archive.json
!data/v2
!data/v2/**

# ── Git metadata ───────────────────────────────────────────────────────────
.git
.gitkeep
.gitignore

# ── Docker files (container içinde gerekmez) ───────────────────────────────
Dockerfile
docker-compose.yml
.dockerignore

# ── Editor / OS artıkları ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
*.local

# ── Test / CI artıkları ────────────────────────────────────────────────────
coverage
.nyc_output
