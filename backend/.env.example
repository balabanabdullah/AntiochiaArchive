NODE_ENV=development
PORT=5000
DATA_STORE=file
# V2_DATA_STORE=local maps data/archive.json into the /api/v2 read-only API
# for local development only. Defaults to 'empty' (no data) when unset —
# never set to 'local' in production. See V2-ARCHITECTURE.md.
# V2_DATA_STORE=local
GOOGLE_CLOUD_PROJECT=antiochia-archive
ADMIN_TOKEN=
ARCHIVE_JSON_PATH=../data/archive.json
SUBMISSIONS_JSON_PATH=../data/submissions.json
MAIL_MODE=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
MAIL_USER=example@gmail.com
MAIL_PASS=your_app_password
MAIL_TO=archive-admin@example.com
CLIENT_URL=http://localhost:5173
